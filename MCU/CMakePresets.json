{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "HOPWINS_ENABLE_BOOT_UWB_CLOCK_DIAGNOSTIC": false
            }
        },
        {
            "name": "Leader-Debug",
            "displayName": "DO Leader (Debug)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HOPWINS_BOARD_TARGET": "LEADER_UWB_ONLY",
                "HOPWINS_APP_ROLE": "DO_LEADER"
            }
        },
        {
            "name": "Leader-Release",
            "displayName": "DO Leader (Release)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "HOPWINS_BOARD_TARGET": "LEADER_UWB_ONLY",
                "HOPWINS_APP_ROLE": "DO_LEADER"
            }
        },
        {
            "name": "Follower-Debug",
            "displayName": "DO Follower (Debug)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HOPWINS_BOARD_TARGET": "FOLLOWER_FULL",
                "HOPWINS_APP_ROLE": "DO_FOLLOWER"
            }
        },
        {
            "name": "Follower-Release",
            "displayName": "DO Follower (Release)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "HOPWINS_BOARD_TARGET": "FOLLOWER_FULL",
                "HOPWINS_APP_ROLE": "DO_FOLLOWER"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Leader-Debug",
            "configurePreset": "Leader-Debug"
        },
        {
            "name": "Leader-Release",
            "configurePreset": "Leader-Release"
        },
        {
            "name": "Follower-Debug",
            "configurePreset": "Follower-Debug"
        },
        {
            "name": "Follower-Release",
            "configurePreset": "Follower-Release"
        }
    ]
}
