# Device Configuration
-a "iCE40UP"
-p iCE40UP5K
-t SG48
-sp "High-Performance_1.2V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Area
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-drc_cfg 35103300 20
-use_io_insertion 1
-resolve_mixed_drivers 0

# Constraint Files
-sdc "test_impl_1_cpe.ldc"

# Search Paths
-path "D:/ice40/ice40k/ispfpga/ice40tp/data"
-path "."
-path ".."
-path "../source/impl_1"

# PMI Library Files
-ver "D:/ice40/ice40k/ip/pmi/pmi_iCE40UP.v"
-lib pmi -vhd "D:/ice40/ice40k/ip/pmi/pmi_iCE40UP.vhd"

# Source Files
-ver "../source/impl_1/top.v"
-path ".."
-top top
# Output Configuration
-udb "test_impl_1_rtl.udb"
-output_hdl "test_impl_1.vm"
