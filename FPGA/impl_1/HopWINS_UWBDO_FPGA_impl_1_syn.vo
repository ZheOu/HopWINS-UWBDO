    (* \dm:primitive ="BB_B" ,
       \dm:programming ="" ,
       \dm:user ="0" *)
    \BB_B  \pps_ob.bb_inst (
      .\T_N (\VCC_net ),
      .\I (\pps_paddo ),
      .\B (\PPS ));

    (* \dm:primitive ="BB_B" ,
       \dm:programming ="" ,
       \dm:user ="0" *)
    \BB_B  \sync_ob.bb_inst (
      .\T_N (\VCC_net ),
      .\I (\sync_paddo ),
      .\B (\SYNC ));

    (* \dm:primitive ="BB_B" ,
       \dm:programming ="" ,
       \dm:user ="0" *)
    \BB_B  \CLK_IN_pad.bb_inst (
      .\T_N (\GND_net ),
      .\O (\CLK_IN_c ),
      .\B (\CLK_IN ),
      .\I (1'b0));

endmodule

