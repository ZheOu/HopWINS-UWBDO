{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MCU: Configure Debug",
            "type": "cmake",
            "command": "configure",
            "preset": "Debug",
            "options": {
                "cwd": "${workspaceFolder}/MCU"
            },
            "problemMatcher": []
        },
        {
            "label": "MCU: Build Debug",
            "type": "cmake",
            "command": "build",
            "preset": "Debug",
            "options": {
                "cwd": "${workspaceFolder}/MCU"
            },
            "dependsOn": "MCU: Configure Debug",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        },
        {
            "label": "MCU: Configure Release",
            "type": "cmake",
            "command": "configure",
            "preset": "Release",
            "options": {
                "cwd": "${workspaceFolder}/MCU"
            },
            "problemMatcher": []
        },
        {
            "label": "MCU: Build Release",
            "type": "cmake",
            "command": "build",
            "preset": "Release",
            "options": {
                "cwd": "${workspaceFolder}/MCU"
            },
            "dependsOn": "MCU: Configure Release",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        }
    ]
}
