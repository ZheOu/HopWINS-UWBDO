{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32: DO Leader Debug",
            "cwd": "${workspaceFolder}/MCU",
            "preLaunchTask": "CMake: Build Leader-Debug",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/MCU/build/Leader-Debug/HopWINS-DO-Leader.elf",
                    "symbolFileName": "${workspaceFolder}/MCU/build/Leader-Debug/HopWINS-DO-Leader.elf"
                }
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32: DO Follower Debug",
            "cwd": "${workspaceFolder}/MCU",
            "preLaunchTask": "CMake: Build Follower-Debug",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/MCU/build/Follower-Debug/HopWINS-DO-Follower.elf",
                    "symbolFileName": "${workspaceFolder}/MCU/build/Follower-Debug/HopWINS-DO-Follower.elf"
                }
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python: Configured Task",
            "module": "hopwins",
            "cwd": "${workspaceFolder}/Python",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/Python/config.ini"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Python/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python: Task Override",
            "module": "hopwins",
            "cwd": "${workspaceFolder}/Python",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/Python/config.ini",
                "--task",
                "${input:hopwinsPythonTask}"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Python/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python: Tests",
            "module": "pytest",
            "cwd": "${workspaceFolder}/Python",
            "args": [
                "tests"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Python/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "hopwinsPythonTask",
            "type": "promptString",
            "description": "Registered task name (see: hopwins tasks)",
            "default": "cir_monitor"
        }
    ]
}
