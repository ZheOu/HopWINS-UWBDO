{
    "cmake.sourceDirectory": "${workspaceFolder}/MCU",
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake"
    ],
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=**/arm-none-eabi-gcc*",
        "--query-driver=**/arm-none-eabi-g++*",
        "--query-driver=**/starm-clang*"
    ]
}
